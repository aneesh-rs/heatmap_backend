MONGODB_URI=mongodb://localhost:27017/heatmap
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
PORT=3000

# Gmail API (transactional email)
# 1. Enable Gmail API in Google Cloud Console
# 2. OAuth Web client: add redirect http://localhost:3333/oauth2callback
# 3. Run: node scripts/gmail-get-refresh-token.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=your-sender@gmail.com
EMAIL_FROM="Heatmap App <your-sender@gmail.com>"
ADMIN_EMAIL=admin@yourdomain.com

FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_PORT=22
FTP_PROTOCOL=sftp
SENTILO_BASE_URL=
SENTILO_IDENTITY_KEY=
NODE_ENV=development

# CloudNoise — production: HTTPS bridge. Local dev: CoAP.
CLOUDNOISE_HTTP_URL=
CLOUDNOISE_HTTP_METHOD=POST
CLOUDNOISE_HTTP_TIMEOUT_MS=15000
CLOUDNOISE_HTTP_API_KEY=

# Local CoAP only (set COAP_ENABLED=true). Do NOT enable on Vercel.
COAP_ENABLED=false
COAP_HOST=10.7.20.90
COAP_PORT=5683
COAP_PATH=/LPWGNS
COAP_TIMEOUT_MS=15000
