MONGODB_URI=mongodb://localhost:27017/heatmap
JWT_SECRET=change-me
FRONTEND_URL=http://localhost:5173
PORT=3000

# Real SMTP required for delivery to yopmail/Gmail/etc.
# Ethereal (smtp.ethereal.email) is DEV ONLY — never reaches real inboxes.
#
# Brevo (free): EMAIL_HOST=smtp-relay.brevo.com EMAIL_PORT=587
# Gmail: use App Password, EMAIL_HOST=smtp.gmail.com EMAIL_PORT=587
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-login@example.com
EMAIL_PASS=your-smtp-key-or-app-password
EMAIL_FROM="Heatmap App <noreply@yourdomain.com>"
ADMIN_EMAIL=admin@yourdomain.com

GOOGLE_CLIENT_ID=
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_PORT=22
FTP_PROTOCOL=sftp
SENTILO_BASE_URL=
SENTILO_IDENTITY_KEY=
NODE_ENV=development
